# ==========================================
# WeatherGPT Environment Configuration
# ==========================================

# OpenWeatherMap API Key (Get from https://openweathermap.org/api)
# Used for live weather forecasts, air quality index, and storm alerts.
# If not provided, WeatherGPT automatically falls back to rich demo data.
OPENWEATHER_API_KEY=your_openweathermap_api_key

# OpenAI API Key (Get from https://platform.openai.com/api-keys)
# Used for conversational AI Weather Buddy responses in Hinglish and regional languages.
OPENAI_API_KEY=your_openai_api_key

# Better Auth Secret (Generate a random 32+ character string)
BETTER_AUTH_SECRET=your_32_character_secret_key_for_auth_sessions

# Application Base URL
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth Credentials (Optional: for Google sign-in)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_username>:<password>@weathergpt.k5rtbgn.mongodb.net/weathergpt?retryWrites=true&w=majority&appName=WeatherGPT

# ==========================================
# Twilio Automated Alerts (SMS & WhatsApp)
# ==========================================
# Get your Account SID and Auth Token from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Your Twilio Phone Number (with country code, e.g. +1234567890)
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# WhatsApp Sender Number (defaults to TWILIO_PHONE_NUMBER or WhatsApp Sandbox number e.g. +14155238886)
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number

# Optional Cron Secret for securing /api/alerts/cron
CRON_SECRET=your_cron_secret_token

# ==========================================
# SIH DEMO: Climate Risk Thresholds & SMS
# ==========================================
# THRESHOLD 1: Max Temperature Threshold (°C) - Extreme Heat Risk
CLIMATE_THRESHOLD_1=40.0

# THRESHOLD 2: Thermal Anomaly Threshold (°C) - Deviation vs 30-Yr IMD Baseline
CLIMATE_THRESHOLD_2=4.5

# THRESHOLD 3: Precipitation / Extreme Rainfall Threshold (mm)
CLIMATE_THRESHOLD_3=100.0

# Cooldown duration in minutes to prevent duplicate SMS on page reloads
CLIMATE_ALERT_COOLDOWN_MINUTES=30

# SMS Provider Credentials (Twilio / Standard SMS Gateway)
# Can use TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN or SMS_API_KEY / SMS_API_SECRET
SMS_API_KEY=your_sms_api_key_or_twilio_sid
SMS_API_SECRET=your_sms_api_secret_or_twilio_token
SMS_FROM=+1234567890
SMS_TO=+919876543210
